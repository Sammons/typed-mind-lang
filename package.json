{
  "name": "@sammons/typed-mind-monorepo",
  "version": "0.1.5",
  "packageManager": "pnpm@11.15.1",
  "private": true,
  "type": "module",
  "description": "TypedMind - A domain-specific language for program architecture",
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sammons/typed-mind-lang"
  },
  "scripts": {
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "lint": "pnpm run -r lint",
    "lint:fix": "pnpm run -r lint:fix",
    "typecheck": "pnpm run -r typecheck",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "dev": "pnpm run -r --parallel dev",
    "validate": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test",
    "validate:fix": "pnpm run build && pnpm run lint:fix && pnpm run typecheck && pnpm run test",
    "ci": "pnpm run validate",
    "precommit": "pnpm run validate:fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
