{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-bundled",
      "!**/node_modules",
      "!lib/typed-mind-static-website/dist",
      "!**/*.vsix",
      "!pnpm-lock.yaml",
      "!lib/typed-mind/grammar/src",
      "!lib/typed-mind-vscode-extension/lsp-bundled",
      "!lib/typed-mind-static-website/assets",
      "!**/*.html",
      "!lib/typed-mind-typescript/tests/ladder/repros-analyzer",
      "!lib/typed-mind-renderer/src/static/client-js",
      "!.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noFallthroughSwitchClause": "warn",
        "useIterableCallbackReturn": "warn"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error",
        "noUnsafeOptionalChaining": "warn",
        "noConstantCondition": "warn",
        "noUnusedPrivateClassMembers": "off"
      },
      "complexity": {
        "noUselessEscapeInRegex": "warn",
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["lib/typed-mind/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error"
          }
        }
      }
    }
  ]
}
