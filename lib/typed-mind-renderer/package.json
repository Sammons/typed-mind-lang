{
  "name": "@sammons/typed-mind-renderer",
  "version": "1.0.0",
  "description": "Enterprise-grade interactive renderer for TypedMind DSL with advanced visualization, performance optimization, pattern recognition, and comprehensive architectural analysis",
  "type": "module",
  "keywords": [
    "typedmind",
    "dsl",
    "renderer",
    "visualization",
    "d3",
    "html",
    "architecture-diagram",
    "performance",
    "virtualization",
    "pattern-recognition",
    "metrics",
    "diff-visualization",
    "code-generation",
    "plugins"
  ],
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammons/typed-mind-lang.git",
    "directory": "lib/typed-mind-renderer"
  },
  "homepage": "https://typedmind.sammons.io",
  "bugs": {
    "url": "https://github.com/Sammons/typed-mind-lang/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced-renderer.d.ts",
      "default": "./dist/advanced-renderer.js"
    },
    "./performance": {
      "types": "./dist/performance/spatial-index.d.ts",
      "default": "./dist/performance/spatial-index.js"
    },
    "./validation": {
      "types": "./dist/validation/error-visualization.d.ts",
      "default": "./dist/validation/error-visualization.js"
    },
    "./plugins": {
      "types": "./dist/plugins/plugin-system.d.ts",
      "default": "./dist/plugins/plugin-system.js"
    },
    "./metrics": {
      "types": "./dist/metrics/graph-metrics.d.ts",
      "default": "./dist/metrics/graph-metrics.js"
    },
    "./patterns": {
      "types": "./dist/patterns/pattern-recognition.d.ts",
      "default": "./dist/patterns/pattern-recognition.js"
    },
    "./diff": {
      "types": "./dist/diff/diff-visualization.d.ts",
      "default": "./dist/diff/diff-visualization.js"
    },
    "./codegen": {
      "types": "./dist/codegen/code-generation.d.ts",
      "default": "./dist/codegen/code-generation.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc --build && pnpm run copy-static",
    "copy-static": "mkdir -p dist && cp -r -u src/static dist/",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "pretest": "pnpm --filter @sammons/typed-mind run build",
    "test": "node --test",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "check:golden-deltas": "node scripts/check-golden-deltas.mjs",
    "typecheck": "tsc --noEmit",
    "guard:npm-publish": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('publish with pnpm, not npm (workspace:* would ship verbatim)'); process.exit(1); }\"",
    "prepublishOnly": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('publish with pnpm, not npm (workspace:* would ship verbatim)'); process.exit(1); }\" && pnpm run clean && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@sammons/typed-mind": "workspace:*"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
