{
  "name": "@sammons/typed-mind-cli",
  "version": "1.0.0",
  "description": "Command-line interface for TypedMind DSL - a declarative language for building software architectures",
  "keywords": [
    "cli",
    "command-line",
    "typedmind",
    "dsl",
    "domain-specific-language",
    "architecture",
    "parser",
    "validator",
    "renderer",
    "ast",
    "visualization"
  ],
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sammons/typed-mind-lang"
  },
  "homepage": "https://github.com/Sammons/typed-mind-lang#readme",
  "bugs": {
    "url": "https://github.com/Sammons/typed-mind-lang/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typed-mind": "./dist/cli.js",
    "tmd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc --build && chmod +x dist/cli.js",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist *.tsbuildinfo *.tgz",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build",
    "prepack": "pnpm run lint && pnpm run typecheck",
    "build:check": "pnpm run build && node dist/cli.js --help",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm test",
    "validate:package": "pnpm exec publint && pnpm exec attw --pack .",
    "release:dry": "pnpm run build && pnpm run validate:package && pnpm publish --dry-run --no-git-checks"
  },
  "dependencies": {
    "@sammons/typed-mind": "workspace:*",
    "@sammons/typed-mind-renderer": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.18.1",
    "publint": "^0.3.24"
  },
  "publishConfig": {
    "access": "public"
  }
}
