# VS Code test files
.vscode/**
.vscode-test/**

# Source files (only include built dist)
src/**
**/*.ts
**/*.map
**/tsconfig.json
tsup.config.ts

# Build and development files
node_modules/**
dist/**/*.map

# lsp-bundled/ carries the bundled LSP server plus its wasm artifacts
# (cli.js, grammar.wasm, web-tree-sitter.wasm) — RFC-TM-5 §3
# (rfc-tm-5-diamond.md). Without this negation the node_modules/** rule above
# has no effect on lsp-bundled/ (it is a sibling directory, not under
# node_modules/), but the carve-out is made explicit design rather than
# relying on omission.
!lsp-bundled/**

# Documentation and development files
docs/**
*.md
!README.md
!CHANGELOG.md

# Configuration files
.gitignore
.yarnrc
.eslintrc.json
**/.eslintrc.json
.prettierrc
vsc-extension-quickstart.md

# Test files
**/*.test.ts
**/*.spec.ts
test/**
tests/**

# Development artifacts
*.log
.env
.env.local