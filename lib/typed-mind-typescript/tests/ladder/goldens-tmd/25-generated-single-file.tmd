program MainApp {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [describe]
}

MainFile @ src/main.ts:
  -> [describe]

class InternalRegistryEntry {
  type: Class
  method: "describe() => string"
  constructor: "(label: string)"
}

describe :: describe(label: string) => string

suppress InternalRegistryEntry checker/orphaned-entity "generated-single-file-scope"
suppress InternalRegistryEntry checker/class-not-exported "generated-single-file-scope"