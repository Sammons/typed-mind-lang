program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [PlainWidget, LoggedWidget]
}

IndexFile @ src/index.ts:
  <- [BaseWidget, WithLogging]
  -> [PlainWidget, LoggedWidget]

MixinFile @ src/mixin.ts:
  <- [BaseWidget]
  -> [WithLogging]

classfile BaseWidget {
  type: ClassFile
  path: src/base.ts
  method: "render() => string"
  exports: [BaseWidget]
}

class PlainWidget {
  type: Class
  extends: BaseWidget
  method: "describe() => string"
}

class LoggedWidget {
  type: Class
  extends: BaseWidget
  method: "describe() => string"
}

WithLogging :: WithLogging(Base: (typeof BaseWidget)) => (typeof BaseWidget)