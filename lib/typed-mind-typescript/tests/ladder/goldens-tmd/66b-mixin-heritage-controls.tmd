IndexFile @ src/index.ts:
  -> [BaseWidget, Container, StringBox, configurableMixin, ConfiguredWidget, inner, outer, NestedWidget]

class BaseWidget {
  type: Class
  method: "render() => string"
}

class Container {
  type: Class
  typeParameter: "T"
  constructor: "(value: T)"
}

class StringBox {
  type: Class
  extends: "Container<string>"
  method: "unwrap() => string"
}

class ConfiguredWidget {
  type: Class
  extends: BaseWidget
  method: "label() => string"
}

class NestedWidget {
  type: Class
  extends: BaseWidget
  method: "depth() => number"
}

configurableMixin :: configurableMixin(_options: { opt: number }, base: (typeof BaseWidget)) => (typeof BaseWidget)

inner :: inner(base: (typeof BaseWidget)) => (typeof BaseWidget)

outer :: outer(base: (typeof BaseWidget)) => (typeof BaseWidget)