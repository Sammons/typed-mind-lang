program Main__App {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [mainFn]
}

MainFile @ src/main.ts:
  -> [mainFn]

MathutilsFile @ src/mathutils.ts:
  -> [add, sub]

MathUtils <: NamespaceImport
  "Namespace import: MathUtils from ./mathutils"
  => [add, sub]

mainFn :: mainFn() => number

add :: add(a: number, b: number) => number

sub :: sub(a: number, b: number) => number