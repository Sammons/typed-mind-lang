program Main__App {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [mainFn]
}

UtilsFormat ^ "format library"

MainFile @ src/main.ts:
  <- [UtilsFormat]
  -> [mainFn]

FormatFile @ src/utils/format.ts:
  -> [formatIt]

mainFn :: mainFn() => string

formatIt :: formatIt(x: string) => string