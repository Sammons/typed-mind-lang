program MainApp {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [mainFn]
}

IndexFile @ src/lib/index.ts:
  <- [WidgetFile.makeWidget]
  <-> [makeWidget]

WidgetFile @ src/lib/widget.ts:
  -> [makeWidget]

MainFile @ src/main.ts:
  <- [IndexFile.makeWidget, IndexFile]
  -> [mainFn]

makeWidget :: makeWidget() => string

mainFn :: mainFn() => string