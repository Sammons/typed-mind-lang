program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [createApi]
}

IndexFile @ src/index.ts:
  <- [HealthFile.default, namedHelper]
  -> [createApi]

HealthFile @ src/routes/health.ts:
  -> [HealthStatus, buildHealthStatus, HealthFile.default]

HelperFile @ src/routes/helper.ts:
  -> [namedHelper]

createApi :: createApi() => string

buildHealthStatus :: buildHealthStatus() => HealthStatus
  -> HealthStatus

namedHelper :: namedHelper() => string

HealthStatus %
  - status: string

HealthFile.default ! src/routes/health.ts
  ~> [buildHealthStatus]