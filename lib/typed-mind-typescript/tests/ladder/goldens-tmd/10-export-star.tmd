program MainApp {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [mainFn]
}

LibFile @ src/lib.ts:
  <- [WidgetFile]
  <-> [makeWidget]

MainFile @ src/main.ts:
  <- [LibFile]
  -> [mainFn]

WidgetFile @ src/widget.ts:
  -> [makeWidget]

mainFn :: mainFn() => string

makeWidget :: makeWidget() => string