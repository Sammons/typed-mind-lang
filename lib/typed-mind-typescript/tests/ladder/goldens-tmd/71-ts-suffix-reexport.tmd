program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [register_routes]
}

IndexFile @ src/index.ts:
  <- [TypesFile.list_types_route, TypesFile]
  -> [register_routes]

TypesListFile @ src/routes/types-list.ts:
  -> [list_types_route]

TypesFile @ src/routes/types.ts:
  <- [TypesListFile.list_types_route]
  <-> [list_types_route]

register_routes :: register_routes() => string

list_types_route :: list_types_route() => string