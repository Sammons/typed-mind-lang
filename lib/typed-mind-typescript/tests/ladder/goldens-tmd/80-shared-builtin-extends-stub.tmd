program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [run]
}

IndexFile @ src/index.ts:
  <- [CliArgumentParser, FileProcessor]
  -> [run]

classfile CliArgumentParser {
  type: ClassFile
  path: src/cli-argument-parser.ts
  imports: [Error]
  method: "parse() => string"
  exports: [CliArgumentError, Error, CliArgumentParser]
}

classfile FileProcessor {
  type: ClassFile
  path: src/file-processor.ts
  imports: [Error]
  method: "process() => string"
  exports: [FileProcessorError, FileProcessor]
}

Error <:
  "Ambient global error type"

CliArgumentError <: Error

FileProcessorError <: Error

run :: run() => string