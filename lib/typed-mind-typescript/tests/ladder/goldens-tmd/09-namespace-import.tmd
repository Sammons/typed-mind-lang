program MainApp {
  type: Program
  entry: MainFile
  version: 1.0.0
  exports: [mainFn]
}

MainFile @ src/main.ts:
  <- [MathUtils]
  -> [mainFn]

MathutilsFile @ src/mathutils.ts:
  -> [add, sub]

class MathUtils {
  type: Class
  implements: [NamespaceImport]
  description: "Namespace import: MathUtils from ./mathutils.js"
  methods: [add, sub]
}

mainFn :: mainFn() => number

add :: add(a: number, b: number) => number

sub :: sub(a: number, b: number) => number