program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [BaseWidget, applyMixin, IsolatedLeaf, LightWidget]
}

IndexFile @ src/index.ts:
  -> [BaseWidget, applyMixin, IsolatedLeaf, LightWidget]

class BaseWidget {
  type: Class
  method: "render() => string"
}

IsolatedLeaf <: BaseWidget
  "The zero-method shape — this is the one that leaked unparsable text."

class LightWidget {
  type: Class
  extends: BaseWidget
  description: "The with-methods shape — took the ClassFile path and emitted safely."
  method: "createRoot() => string"
}

applyMixin :: applyMixin(base: (typeof BaseWidget)) => (typeof BaseWidget)