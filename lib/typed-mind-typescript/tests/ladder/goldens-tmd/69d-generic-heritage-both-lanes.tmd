program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [Item, Repo, GenericChild, GenericBase, GenericDerived, drive]
}

IndexFile @ src/index.ts:
  -> [Item, Repo, GenericChild, GenericBase, GenericDerived, drive]

class GenericBase {
  type: Class
  typeParameter: "T"
  method: "hold(value: T) => void"
}

class GenericDerived {
  type: Class
  extends: "GenericBase<string>"
  method: "run() => void"
}

class Repo {
  type: Class
  typeParameter: "T"
  method: "find(id: string) => T"
}

GenericChild <: Repo<Item>

drive :: drive(a: GenericChild, b: GenericDerived) => void

Item %
  - id: string