# Programs
IndexApp -> IndexFile v1.0.0
  -> [main]

# Files
IndexFile @ project/src/index.ts:
  <- [UserService]
  -> [main]

# ClassFiles (Services/Controllers)
UserService #: project/src/services/user-service.ts <: BaseService, IUserService
