program IndexApp {
  type: Program
  entry: IndexFile
  version: 1.0.0
  exports: [main]
}

IndexFile @ project/src/index.ts:
  <- [UserService]
  -> [main]

UserServiceFile @ project/src/services/user-service.ts:
  <- [UserDTO, CreateUserDTO]
  -> [UserService]

class UserService {
  type: Class
  extends: BaseService
  implements: [IUserService]
  method: "async createUser(data: CreateUserDTO) => Promise<UserDTO>"
  method: "async findUser(id: string) => Promise<UserDTO | null>"
}

main :: async main() => Promise<void>

UserDTO %
  - id: string
  - name: string
  - email: string
  - createdAt?: Date

CreateUserDTO %
  - name: string
  - email: string