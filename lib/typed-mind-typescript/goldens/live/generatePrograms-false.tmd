IndexFile @ project/src/index.ts:
  <- [UserService]
  -> [main]

classfile UserService {
  type: ClassFile
  path: project/src/services/user-service.ts
  extends: BaseService
  implements: [IUserService]
  imports: [UserDTO, CreateUserDTO]
  method: "async createUser(data: CreateUserDTO) => Promise<UserDTO>"
  method: "async findUser(id: string) => Promise<UserDTO | null>"
  exports: [UserService]
}

main :: async main() => Promise<void>

UserDTO %
  - id: string
  - name: string
  - email: string
  - createdAt?: Date

CreateUserDTO %
  - name: string
  - email: string