{
  "name": "@sammons/typed-mind",
  "version": "1.0.0",
  "description": "Core language parser and validator for TypedMind DSL - a declarative language for building software architectures",
  "keywords": [
    "typedmind",
    "dsl",
    "parser",
    "validator",
    "architecture",
    "declarative",
    "software-design"
  ],
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sammons/typed-mind-lang"
  },
  "homepage": "https://github.com/Sammons/typed-mind-lang#readme",
  "bugs": {
    "url": "https://github.com/Sammons/typed-mind-lang/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "grammar.md",
    "grammar.ebnf"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "generate-grammar-docs": "pnpm build && node dist/generate-grammar-doc.js",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
