{
  "name": "@sammons/typed-mind",
  "version": "1.1.0",
  "description": "Core language parser and validator for TypedMind DSL - a declarative language for building software architectures",
  "type": "module",
  "keywords": [
    "typedmind",
    "dsl",
    "parser",
    "validator",
    "architecture",
    "declarative",
    "software-design"
  ],
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammons/typed-mind-lang.git",
    "directory": "lib/typed-mind"
  },
  "homepage": "https://typedmind.sammons.io",
  "bugs": {
    "url": "https://github.com/Sammons/typed-mind-lang/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "grammar.wasm",
    "README.md",
    "grammar.md",
    "grammar.ebnf"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-wasm.mjs",
    "build": "tsc --build",
    "build:browser": "tsc --build tsconfig.browser.json --force",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist dist-browser *.tsbuildinfo grammar.wasm",
    "pretest": "node scripts/build-wasm.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "generate-grammar-docs": "node grammar/codegen/generate-grammar-docs.mjs",
    "prepack": "node scripts/build-wasm.mjs && node scripts/stage-published-wasm.mjs",
    "guard:npm-publish": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('publish with pnpm, not npm (workspace:* would ship verbatim)'); process.exit(1); }\"",
    "prepublishOnly": "node -e \"if (!(process.env.npm_config_user_agent||'').startsWith('pnpm/')) { console.error('publish with pnpm, not npm (workspace:* would ship verbatim)'); process.exit(1); }\" && pnpm run clean && pnpm run build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.0"
  }
}
