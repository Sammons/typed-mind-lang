{
  "name": "@sammons/typed-mind-tree-sitter-common",
  "version": "0.1.0",
  "description": "Shared infrastructure for TypedMind tree-sitter language analyzers",
  "type": "module",
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammons/typed-mind-lang.git",
    "directory": "lib/typed-mind-tree-sitter-common"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "pretest": "pnpm --filter @sammons/typed-mind run build",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sammons/typed-mind": "workspace:*",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
