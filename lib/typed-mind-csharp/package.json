{
  "name": "@sammons/typed-mind-csharp",
  "version": "1.2.0",
  "description": "TypedMind C# architecture analyzer using tree-sitter",
  "type": "module",
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammons/typed-mind-lang.git",
    "directory": "lib/typed-mind-csharp"
  },
  "homepage": "https://typedmind.sammons.io",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "typed-mind-cs": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "grammar"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc --build && chmod +x dist/cli.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prebuild": "node scripts/build-wasm.mjs",
    "pretest": "pnpm --filter @sammons/typed-mind run build && pnpm --filter @sammons/typed-mind-tree-sitter-common run build && node scripts/build-wasm.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sammons/typed-mind": "workspace:*",
    "@sammons/typed-mind-tree-sitter-common": "workspace:*",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tree-sitter-c-sharp": "0.23.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
