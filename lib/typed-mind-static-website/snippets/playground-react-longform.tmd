# Longform syntax is for humans
program DashboardApp {
  entry: main
  version: 1.0.0
}

file main {
  path: src/index.tsx
  imports: [App, ChartService]
  exports: [App, ChartService]
}

component App {
  description: "Root dashboard component"
  root: true
  contains: [Sidebar, ChartPanel]
}

component Sidebar {
  description: "Navigation sidebar"
  contains: [NavLink]
  containedBy: [App]
}

component NavLink {
  description: "Single sidebar navigation link"
  containedBy: [Sidebar]
}

component ChartPanel {
  description: "Main chart display area"
  containedBy: [App]
}

class ChartService {
  methods: [fetchRevenue]
}

function fetchRevenue {
  signature: (range: DateRange) => RevenueSeries
  description: "Fetches revenue data for the dashboard's chart panel"
  input: DateRange
  output: RevenueSeries
}

dto DateRange {
  description: "Chart date range filter"
  fields: {
    start: {
      type: "Date"
      description: "Range start"
    }
    end: {
      type: "Date"
      description: "Range end"
    }
  }
}

dto RevenueSeries {
  description: "Time series for the revenue chart"
  fields: {
    points: {
      type: "number[]"
      description: "Revenue values"
    }
    labels: {
      type: "string[]"
      description: "X-axis labels"
    }
  }
}