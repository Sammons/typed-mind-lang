# Shortform syntax is for LLMs
EdgeGateway -> router v1.0.0

router @ router.ts:
  <- [GatewayRouter]
  -> [GatewayRouter]

GatewayRouter <:
  => [forwardRequest]

RouteTable % "Path-to-backend route mapping"
  - path: string "Matched request path prefix"
  - backend: string "Upstream service name"

ROUTE_TABLE ! routes.config.ts : RouteTable

forwardRequest :: (request: InboundRequest) => ProxiedResponse
  "Matches the request path against the route table and proxies to the backend"
  <- InboundRequest
  -> ProxiedResponse
  $< [ROUTE_TABLE, RATE_LIMIT_PER_MINUTE]

users-service ^ "Upstream users backend" v1.2.0
billing-service ^ "Upstream billing backend" v4.0.0

InboundRequest % "Incoming HTTP request"
  - path: string "Request path"
  - method: string "HTTP method"

ProxiedResponse % "Response proxied from a backend service"
  - status: number "HTTP status code"
  - body: string "Response body"
  - matchedRoute: RouteTable "Route table entry that matched this request"

RATE_LIMIT_PER_MINUTE $env "Per-client request budget" (required)
