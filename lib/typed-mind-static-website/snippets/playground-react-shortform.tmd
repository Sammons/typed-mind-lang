# Shortform syntax is for LLMs
DashboardApp -> main v1.0.0

main @ src/index.tsx:
  <- [App, ChartService]
  -> [App, ChartService]

App &! "Root dashboard component"
  > [Sidebar, ChartPanel]

Sidebar & "Navigation sidebar"
  < [App]
  > [NavLink]

NavLink & "Single sidebar navigation link"
  < [Sidebar]

ChartPanel & "Main chart display area"
  < [App]

ChartService <:
  => [fetchRevenue]

fetchRevenue :: (range: DateRange) => RevenueSeries
  "Fetches revenue data for the dashboard's chart panel"
  <- DateRange
  -> RevenueSeries

DateRange % "Chart date range filter"
  - start: Date "Range start"
  - end: Date "Range end"

RevenueSeries % "Time series for the revenue chart"
  - points: number[] "Revenue values"
  - labels: string[] "X-axis labels"
