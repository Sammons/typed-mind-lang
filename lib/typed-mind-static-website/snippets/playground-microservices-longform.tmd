# Longform syntax is for humans
program OrderPlatform {
  entry: gateway
  version: 1.0.0
}

file gateway {
  path: gateway-service.ts
  imports: [OrderGateway]
  exports: [OrderGateway]
}

class OrderGateway {
  methods: [routeOrder]
}

function routeOrder {
  signature: (input: PlaceOrderInput) => OrderReceipt
  description: "Routes an incoming order to the inventory and payment services"
  input: PlaceOrderInput
  output: OrderReceipt
  consumes: [INVENTORY_SERVICE_URL, PAYMENT_SERVICE_URL]
}

dependency "inventory-client" {
  description: "Inventory microservice HTTP client"
  version: 2.4.0
}

dependency "payment-client" {
  description: "Payment microservice HTTP client"
  version: 3.1.0
}

dto PlaceOrderInput {
  description: "Order placement request"
  fields: {
    sku: {
      type: "string"
      description: "Product SKU"
    }
    quantity: {
      type: "number"
      description: "Units ordered"
    }
  }
}

dto OrderReceipt {
  description: "Order confirmation"
  fields: {
    orderId: {
      type: "string"
      description: "Generated order identifier"
    }
    status: {
      type: "string"
      description: "Order status"
    }
  }
}

parameter INVENTORY_SERVICE_URL {
  type: env
  description: "Inventory service base URL"
  required: true
}

parameter PAYMENT_SERVICE_URL {
  type: env
  description: "Payment service base URL"
  required: true
}