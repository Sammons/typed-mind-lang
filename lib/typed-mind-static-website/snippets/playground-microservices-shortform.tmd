# Shortform syntax is for LLMs
OrderPlatform -> gateway v1.0.0

gateway @ gateway-service.ts:
  <- [OrderGateway]
  -> [OrderGateway]

OrderGateway <:
  => [routeOrder]

routeOrder :: (input: PlaceOrderInput) => OrderReceipt
  "Routes an incoming order to the inventory and payment services"
  <- PlaceOrderInput
  -> OrderReceipt
  $< [INVENTORY_SERVICE_URL, PAYMENT_SERVICE_URL]

inventory-client ^ "Inventory microservice HTTP client" v2.4.0
payment-client ^ "Payment microservice HTTP client" v3.1.0

PlaceOrderInput % "Order placement request"
  - sku: string "Product SKU"
  - quantity: number "Units ordered"

OrderReceipt % "Order confirmation"
  - orderId: string "Generated order identifier"
  - status: string "Order status"

INVENTORY_SERVICE_URL $env "Inventory service base URL" (required)
PAYMENT_SERVICE_URL $env "Payment service base URL" (required)
