{
  "name": "@sammons/typed-mind-lsp",
  "version": "1.0.0",
  "description": "Language Server Protocol implementation for TypedMind DSL - providing IDE support with syntax highlighting, validation, and intellisense",
  "type": "module",
  "keywords": [
    "typedmind",
    "dsl",
    "lsp",
    "language-server",
    "vscode",
    "ide",
    "syntax-highlighting"
  ],
  "author": "sammons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sammons/typed-mind-lang.git",
    "directory": "lib/typed-mind-lsp"
  },
  "homepage": "https://typedmind.sammons.io",
  "bugs": {
    "url": "https://github.com/Sammons/typed-mind-lang/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "typed-mind-lsp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "build:bundled": "tsup --config tsup.bundled.config.ts",
    "dev": "tsc --build --watch",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dist-bundled *.tsbuildinfo",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@sammons/typed-mind": "workspace:*",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
